<div role="grid" class="calendar-grid">
  <!-- Days of week header -->
  <div role="row" class="calendar-row calendar-header">
    {#each weekdays as day}
      <div role="columnheader" class="calendar-cell calendar-weekday">
        {day}
      </div>
    {/each}
  </div>
  
  <!-- Calendar days -->
  {#each weeks as week}
    <div role="row" class="calendar-row">
      {#each week as date}
        {@const isDisabled = isDateDisabled(date)}
        {@const isSelected = isSameDay(date, value)}
        {@const isToday = isSameDay(date, today)}
        {@const customData = renderDate ? renderDate(date) : null}
        {@const hasBookings = customData?.hasBookings || false}
        
        <div 
          role="gridcell" 
          aria-disabled={isDisabled} 
          aria-selected={isSelected}
          class="calendar-cell 
                 {isDisabled ? 'calendar-cell-disabled' : ''} 
                 {isSelected ? 'calendar-cell-selected' : ''} 
                 {isToday ? 'calendar-cell-today' : ''} 
                 {hasBookings ? 'calendar-cell-with-bookings' : ''}"
          on:click={() => {
            if (!isDisabled) {
              handleSelect(date);
            }
          }}
        >
          <span>
            {date.day}
          </span>
        </div>
      {/each}
    </div>
  {/each}
</div> 